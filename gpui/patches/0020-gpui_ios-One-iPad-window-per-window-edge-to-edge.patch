+                    CGPoint::new(start, top + 26.0),
+                    CGSize::new(text_width, 16.0),
+                )];
+            }
+            let _: () = msg_send![&self.trailing, setFrame: CGRect::new(
+                CGPoint::new(width - 48.0, top),
+                CGSize::new(44.0, height),
+            )];
+        }
+    }
