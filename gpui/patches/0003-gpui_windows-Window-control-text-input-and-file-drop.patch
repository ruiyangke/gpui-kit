+        );
+        // WINDOWPLACEMENT uses workspace coordinates. Compare its native
+        // restore rectangle directly, never apply it as screen coordinates.
+        ensure!(
+            rect(placement(target.hwnd)?.rcNormalPosition) == rect(original.rcNormalPosition),
