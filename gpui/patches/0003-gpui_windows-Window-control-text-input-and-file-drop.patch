+        })));
+    })?;
+    ensure!(
+        observe_fullscreen_focus(
+            "before-fullscreen-entry",
+            anchor_hwnd,
+            owned,
+            &focus_events,
+            report
+        ) == anchor_hwnd,
+        "Foreground changed before fullscreen entry; inspect focus identities"
+    );
+    anchor
+        .window
+        .update(cx, |_, window, _| window.toggle_fullscreen())?;
