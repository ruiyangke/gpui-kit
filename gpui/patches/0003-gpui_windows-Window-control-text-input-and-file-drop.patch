+            !fullscreen
+                && style & (WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX).0 == 0
+                && style & WS_CAPTION.0 == WS_CAPTION.0
+        },
+    )
+    .await;
