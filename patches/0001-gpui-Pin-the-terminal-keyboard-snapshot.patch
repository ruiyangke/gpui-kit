diff --git a/Cargo.toml b/Cargo.toml
index d1c15ca7..1250ebbe 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -66,18 +66,18 @@ story = { path = "crates/story" }
 # onto a newer snapshot that gpui-component did not compile with (#3156). Bump
 # every snapshot crate together with its Cargo.lock entry; `script/check-gpui-pin.ts`
 # fails CI when a pin is not exact.
-gpui = { package = "gpui-pre", version = "=0.3.9" }
-gpui_platform = { package = "gpui-pre-platform", version = "=0.3.9", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
-gpui_web = { package = "gpui-pre-web", version = "=0.3.9" }
+gpui = { package = "gpui-pre", version = "=0.3.9", git = "https://github.com/ruiyangke/gpui-kit", rev = "ab40fa8bbac4114552547153f1df88fab550289e" }
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.9", git = "https://github.com/ruiyangke/gpui-kit", rev = "ab40fa8bbac4114552547153f1df88fab550289e", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
+gpui_web = { package = "gpui-pre-web", version = "=0.3.9", git = "https://github.com/ruiyangke/gpui-kit", rev = "ab40fa8bbac4114552547153f1df88fab550289e" }
 # Fast is optional; existing crates select it through their gpui-fast feature.
 # Explicit package fields make Cargo use these dependency keys as Rust crate names;
 # the packages declare the same library names as the pre backend.
