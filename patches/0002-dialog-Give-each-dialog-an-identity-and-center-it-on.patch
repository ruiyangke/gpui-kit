+    /// Dismiss exactly the captured dialog. A covered dialog may disappear
+    /// without dismissing its successor or restoring focus into the background.
+    pub(crate) fn close_dialog_if(
+        &mut self,
+        focus: &FocusHandle,
+        window: &mut Window,
+        cx: &mut Context<'_, WindowState>,
+    ) -> bool {
+        let Some(index) = self
+            .active_dialogs
+            .iter()
+            .position(|dialog| &dialog.focus_handle == focus)
+        else {
+            return false;
+        };
+        if index + 1 == self.active_dialogs.len() {
+            self.close_dialog(window, cx);
+        } else {
+            let removed = self.active_dialogs.remove(index);
+            removed.active.set(false);
+            self.active_dialogs[index].previous_focused_handle = removed.previous_focused_handle;
+            self.pending_focus_restore = None;
+            cx.notify();
+        }
+        true
+    }
