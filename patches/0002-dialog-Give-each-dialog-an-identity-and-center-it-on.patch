+/// Identity and liveness of a dialog owned by one presentation surface.
+#[derive(Clone)]
+pub struct DialogHandle {
+    focus: FocusHandle,
+    active: Rc<Cell<bool>>,
+}
+impl DialogHandle {
+    /// True only while this dialog is open and owns the top modal layer.
+    pub fn is_active(&self) -> bool {
+        self.active.get()
+    }
+    pub fn focus_handle(&self) -> &FocusHandle {
+        &self.focus
+    }
+}
 
